# Пример настроек. Скопируйте в .env и заполните. Для локального демо можно ничего не задавать —
# у каждой переменной есть значение по умолчанию для разработки. В боевом режиме (APP_ENV=production)
# сервисы не запустятся без своих секретов. Описание каждой переменной — в README, раздел «Настройки».

APP_ENV=development

# --- Секреты: раскомментировать и задать свои (например, `openssl rand -hex 32`, от 32 символов) ---
# JWT_SECRET=
# PII_PEPPER=
# HMAC-подпись обмена backend ↔ Go-сервисы (одно и то же значение у backend и у сервиса)
# SMEV_HMAC_SECRET=
# BKI_HMAC_SECRET=
# TOKENIZER_HMAC_SECRET=
# Ключ OPRF токенизатора паспорта (base64). Не задан — берётся из файла secrets/oprf.key (создаётся при первом запуске, права 600)
# OPRF_PRIVATE_KEY=
# Ключ Ed25519 для подписи PDF-справки. Не задан — secrets/cert_ed25519.key
# CERT_SIGNING_KEY=

# --- Go-сервисы (services/): адреса, порты, доступ ---
SMEV_URL=http://127.0.0.1:8101
BKI_URL=http://127.0.0.1:8102
TOKENIZER_URL=http://127.0.0.1:8103
SMEV_PORT=8101
BKI_PORT=8102
TOKENIZER_PORT=8103
# На каком адресе слушают Go-сервисы. По умолчанию только localhost; в Docker задаётся 0.0.0.0 (сеть закрытая)
BIND_HOST=127.0.0.1
# Файл ключа OPRF (по умолчанию secrets/oprf.key)
# OPRF_KEY_FILE=secrets/oprf.key
# Кому, кроме localhost, можно трогать /chaos у СМЭВ и БКИ (через запятую, сети в формате CIDR)
# CHAOS_ALLOW_NETS=172.31.0.0/24

# --- База и учётки сотрудников ---
DATABASE_PATH=backend/data/credit_v6.sqlite
# CREDENTIALS_FILE=secrets/credentials.local.json
# ADMIN_PASSWORD=

# --- Вход клиента (раздел 6.2 контракта). Не настроен ни один способ — включается демо-код на экране ---
# Демо-вход: 1 — включить, 0 — выключить. В production включается только явным AUTH_DEMO=1
# AUTH_DEMO=1
# Telegram-бот: бот создаёт @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Звонок-подтверждение (SMS.RU callcheck)
# SMSRU_API_ID=
# Яндекс ID (OAuth)
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK ID (OAuth 2.1 + PKCE)
# VK_CLIENT_ID=

# --- Прочее ---
DUPLICATE_CHECK=on
# CORS_ORIGINS=http://localhost:5173
