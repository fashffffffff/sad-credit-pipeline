# Пример настроек. Скопируйте в .env и заполните. Для локального демо можно ничего не задавать —
# у каждой переменной есть значение по умолчанию для разработки. В боевом режиме (APP_ENV=production)
# сервер не запустится без своих секретов. Описание каждой переменной — в README, раздел «Настройки».

APP_ENV=development

# Секреты: раскомментировать и задать свои (например, `openssl rand -hex 32`)
# JWT_SECRET=
# SMEV_HMAC_SECRET=
# BKI_HMAC_SECRET=
# TOKENIZER_HMAC_SECRET=
# PII_PEPPER=

# Внешние сервисы (Go)
SMEV_URL=http://127.0.0.1:8101
BKI_URL=http://127.0.0.1:8102
TOKENIZER_URL=http://127.0.0.1:8103

DATABASE_PATH=backend/data/credit_v6.sqlite
EXTERNAL_LOG=logs/external.log      # каждая попытка вызова СМЭВ/БКИ — строка JSON
AUTO_RETRY_SECONDS=60               # автоповтор NEED_MORE_DATA / EXTERNAL_TIMEOUT (0 — выключить)

# Справка PDF
# CERT_SIGNING_KEY=                 # base64 от 32 байт; пусто — файл secrets/cert_ed25519.key (создаётся сам, права 600)
# CERT_FONT=/путь/к/шрифту.ttf      # TTF с кириллицей; пусто — ищем DejaVuSans / Arial в системе
PUBLIC_BASE_URL=https://credit.fashf.ru

# CREDENTIALS_FILE=secrets/credentials.local.json
# ADMIN_PASSWORD=

DUPLICATE_CHECK=on
# CORS_ORIGINS=http://localhost:5173
