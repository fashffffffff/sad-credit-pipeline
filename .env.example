# Пример настроек. Скопируйте в .env и заполните. Для локального демо можно ничего не задавать —
# у каждой переменной есть значение по умолчанию для разработки. В боевом режиме (APP_ENV=production)
# сервер не запустится без своих секретов. Описание каждой переменной — в README, раздел «Настройки».

APP_ENV=development

# Секреты: раскомментировать и задать свои (например, `openssl rand -hex 32`)
# JWT_SECRET=
# SMEV_HMAC_SECRET=
# BKI_HMAC_SECRET=
# PII_PEPPER=

SMEV_URL=http://127.0.0.1:8101
BKI_URL=http://127.0.0.1:8102
DATABASE_PATH=backend/data/app.db

# CREDENTIALS_FILE=secrets/credentials.local.json
# ADMIN_PASSWORD=

EMPLOYER_CHECK=offline
DUPLICATE_CHECK=on
# CORS_ORIGINS=http://localhost:5173
